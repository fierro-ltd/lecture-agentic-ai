# Caddy reverse proxy for Lecture Agentic AI
# Auto-provisions HTTPS via Let's Encrypt.
#
# Install: apt install caddy
# Deploy:  cp Caddyfile /etc/caddy/Caddyfile && systemctl restart caddy

lecture-agentic-ai.fierro.co.uk {
    # Demo UI (landing + pipeline + reviewer) — path-based routing (Cloudflare blocks non-standard ports)
    # /review redirects to /review/, /review/* strips prefix and proxies to nginx
    redir /review /review/ 308
    handle_path /review/* {
        reverse_proxy localhost:3200
    }

    # Paperclip UI — default handler
    handle {
        reverse_proxy localhost:3100 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}

# HAST API — HTTPS on port 8443 (Cloudflare-supported port)
lecture-agentic-ai.fierro.co.uk:8443 {
    reverse_proxy localhost:8000
}

# Temporal UI — HTTPS on port 9233 (internal access only)
lecture-agentic-ai.fierro.co.uk:9233 {
    reverse_proxy localhost:8233
}
