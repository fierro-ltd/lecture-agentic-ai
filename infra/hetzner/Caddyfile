# Caddy reverse proxy for Lecture Agentic AI (demo deployment).
#
# Public HTTPS ports must be in Cloudflare's allowed HTTPS port list
# (free plan: 443, 2053, 2083, 2087, 2096, 8443). Paperclip is served from
# its own port at root because its built assets reference absolute /assets/...
# paths and we do not modify upstream Paperclip.
#
# Cloudflare SSL/TLS mode: "Full".
# Auth is intentionally OFF on every endpoint — this is a public capability
# demo, not a production deployment.
#
# Install: apt install caddy
# Deploy:  cp Caddyfile /etc/caddy/Caddyfile && systemctl reload caddy

# Demo UI (landing page + pipeline + reviewer) — root site
lecture-agentic-ai.fierro.co.uk {
    reverse_proxy localhost:3200
}

# Paperclip admin UI — its OWN root on port 8443 (so absolute /assets/* work)
lecture-agentic-ai.fierro.co.uk:8443 {
    reverse_proxy localhost:3100
}

# Temporal UI — HTTPS on port 2087 (open, no basic-auth — demo only)
lecture-agentic-ai.fierro.co.uk:2087 {
    reverse_proxy localhost:8233
}

# HAST API + Swagger docs — HTTPS on port 2096
lecture-agentic-ai.fierro.co.uk:2096 {
    reverse_proxy localhost:8000
}
